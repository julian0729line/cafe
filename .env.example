# Variables de entorno del Café Literario.
# Copia este archivo como .env.local (para desarrollo) y rellena los valores.
# En Vercel, agrégalas en: Project → Settings → Environment Variables.
#
# Las encuentras en supabase.com → tu proyecto → Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY

# Nota: la página de inicio funciona sin estas variables.
# Login / registro / dashboard / perfil las necesitan, y también el
# formulario de /contacto (sin ellas, muestra un aviso y no falla el build).

# Dominio real de producción (sin barra final), usado por SEO para el
# canonical, Open Graph y sitemap.xml. Sin esta variable, esos metadatos
# caen a http://localhost:3000 en cualquier entorno, incluida producción.
NEXT_PUBLIC_SITE_URL=https://tu-dominio-real.com

# Opcionales — SEO/medición. Sin configurar, el sitio funciona igual (no-op):
# GA4: Google Analytics → Admin → Flujos de datos → tu flujo web → ID de medición.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# Google Search Console: Configuración → Verificación de propiedad → método
# "Etiqueta HTML" → solo el valor del atributo content (sin el resto del tag).
NEXT_PUBLIC_GSC_VERIFICATION=tu-codigo-de-verificacion
